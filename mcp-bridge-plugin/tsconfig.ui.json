{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": []
  },
  "include": ["src/ui.ts", "src/i18n.ts", "src/shared/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
