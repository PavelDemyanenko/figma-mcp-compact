{
  "name": "figma-mcp-compact-plugin",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:code && npm run build:ui",
    "build:code": "vite build --mode code",
    "build:ui": "vite build --mode ui",
    "watch": "vite build --mode code --watch & vite build --mode ui --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
